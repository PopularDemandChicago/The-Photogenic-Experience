# https://resend.com — verify thephotogenicexperience.com, then create an API key.
RESEND_API_KEY=

# Inbox that receives booking inquiries.
CONTACT_TO_EMAIL=hello@thephotogenicexperience.com

# Must use an address on the domain you verified in Resend.
CONTACT_FROM_EMAIL=The Photogenic Experience <hello@thephotogenicexperience.com>

# Optional: natural-language chat (falls back to built-in FAQs if unset).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: Calendly or booking link shown in chat + guest follow-up email.
BOOKING_URL=
NEXT_PUBLIC_BOOKING_URL=

# Canonical URL for sitemap.xml / robots.txt (production).
NEXT_PUBLIC_SITE_URL=https://www.thephotogenicexperience.com
